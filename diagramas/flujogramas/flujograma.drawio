        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle FLUJOGRAMA DEL SISTEMA NEXUS\nstart\n\n:Iniciar programa;\n:Crear sistema NEXUS;\n:Mostrar menú principal;\n\nwhile (¿Salir del juego?) is (No)\n  :Elegir una opción;\n\n  if (¿Explorar zona?) then (Sí)\n    :Mostrar zona;\n    :Explorar y encontrar personajes;\n\n    if (¿Hay encuentro?) then (Sí)\n      :Iniciar encuentro;\n      :Ejecutar acciones del personaje;\n      :Aplicar daño o efectos;\n    endif\n\n    :Actualizar progreso y experiencia;\n\n  else (No)\n    if (¿Ver inventario?) then (Sí)\n      :Mostrar objetos;\n      :Usar objeto si corresponde;\n    else (Otra opción)\n      :Consultar misión o información;\n    endif\n  endif\n\n  :Comprobar objetivos de la misión;\n\n  if (¿Misión completada?) then (Sí)\n    :Mostrar mensaje de victoria;\n  endif\n\nendwhile (Sí)\n\n:Finalizar programa;\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wvmwG4d8s4J4M4-UoqbT-1">
