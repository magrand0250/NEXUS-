        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Diagrama de Clases - NEXUS\n\nclass Program {\n  +Main()\n}\n\nclass SistemaNexus {\n  -Cadete cadete\n  -Mision mision\n  +Iniciar()\n  -Explorar()\n  -Encuentro(Personaje)\n}\n\nabstract class Personaje {\n  #Nombre\n  #Vida\n  +RecibirDanio()\n  +MostrarInformacion()\n  {abstract} Actuar()\n}\n\nclass Cadete {\n  +Energia\n  +Experiencia\n  +GastarEnergia()\n  +RecuperarEnergia()\n  +GanarExperiencia()\n  +Actuar()\n}\n\nclass Robot {\n  +Actuar()\n  +MostrarInformacion()\n}\n\nclass Enemigo {\n  +Actuar()\n  +MostrarInformacion()\n}\n\nclass Inventario {\n  -objetos : List&lt;Objeto&gt;\n  +Agregar(Objeto)\n  +Mostrar()\n  +Usar()\n}\n\nclass Objeto {\n  +Nombre\n  +Tipo\n  +Poder\n}\n\nclass Zona {\n  +Nombre\n  +Descripcion\n}\n\nclass Mision {\n  -objetivo1 : bool\n  -objetivo2 : bool\n  -objetivo3 : bool\n  -objetivo4 : bool\n  +ComprobarObjetivos()\n}\n\nProgram ..&gt; SistemaNexus : crea\nPersonaje &lt;|-- Cadete\nPersonaje &lt;|-- Robot\nPersonaje &lt;|-- Enemigo\nSistemaNexus --&gt; Cadete\nSistemaNexus --&gt; Mision\nSistemaNexus --&gt; Zona\nSistemaNexus ..&gt; Personaje : encuentros\nCadete *-- Inventario\nInventario o-- Objeto\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DIJiKnzloaLN9KXyNYKz-1">
